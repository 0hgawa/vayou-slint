# Maintainer: Ohgawa <https://github.com/0hgawa>
#
# Arch package — the counterpart of install-linux.sh, and the reason it exists:
# a tarball cannot declare what it needs, so whoever unpacks one has to know to
# install libmpv by hand. `depends` is that knowledge, written down once, in the
# only place a package manager reads.
#
# This is the template, not a usable PKGBUILD: `@PKGVER@` and `@SHA256@` are
# filled in by the release workflow and the result is published as a release
# asset. Nothing else here moves between versions.
#
# It has to work that way round. The checksum measures the source archive GitHub
# generates for a tag, and that archive contains this file — a hash written
# before the tag would have to predict its own effect on the tree it is hashing.
# Generating after the tag is what breaks the circle, and keeping only a template
# in the repository is what stops a second, permanently wrong copy existing
# beside the generated one.
#
# The finished file, matching the version it was built for:
#
#   curl -O https://github.com/0hgawa/vayou-slint/releases/latest/download/PKGBUILD
#   makepkg -si          # build and install
#   makepkg -f --check   # rebuild, running the test suite

pkgname=vayou
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Native video player — libmpv engine, Slint UI, frameless single window'
arch=('x86_64')
url='https://github.com/0hgawa/vayou-slint'
license=('MIT')

# Every entry is something the binary reaches for by name at runtime, read out of
# the build rather than guessed: `readelf -d` for what it links (fontconfig,
# gcc-libs, glibc) and the dlopen names embedded in the binary for the rest.
# Transitive libraries — mesa, llvm, libdrm, the whole driver stack under
# libglvnd — are deliberately absent; they arrive with the packages below.
depends=(
  # The engine. Nothing plays without it, which is the entire point of this file.
  'mpv'
  # Subtitle extraction and translation shell out to it.
  'ffmpeg'
  # Linked directly (DT_NEEDED).
  'fontconfig'
  'gcc-libs'
  'glibc'
  # The GL/EGL entry points glutin resolves for the video underlay.
  'libglvnd'
  # Wayland: the session this runs in most often now.
  'wayland'
  # X11: still the fallback path, and winit opens all of these by name.
  'libx11'
  'libxcb'
  'libxcursor'
  'libxi'
  'libxrender'
  # Keyboard handling on both display servers.
  'libxkbcommon'
  'libxkbcommon-x11'
)

makedepends=('cargo')

# Link-time optimisation off, and not as a preference: makepkg's `lto` puts
# -flto in CFLAGS, which reaches the C sources `ring` (via rustls, via reqwest)
# compiles through the cc crate. Those land as LLVM bitcode that the Rust link
# step will not resolve, and the build dies on a page of "undefined symbol:
# ring_core_*". Distributions that enable LTO globally — CachyOS does — hit this
# on every Rust package that carries C, which is why the flag is disabled here
# rather than in one machine's makepkg.conf.
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('@SHA256@')

prepare() {
  cd "vayou-slint-$pkgver"
  # The repo pins an exact compiler in rust-toolchain.toml so CI, releases and
  # developers share one. A package build is none of those: it must use the Rust
  # the machine already has rather than making rustup download another.
  export RUSTUP_TOOLCHAIN=stable
  # Vendor now, with the network still allowed, so build() can run offline.
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "vayou-slint-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Keep the build directory out of the shipped binary: rustc bakes absolute
  # paths into panic messages and debug info, and makepkg flags the result
  # ("Package contains reference to $srcdir"). Appended rather than assigned, so
  # a distribution's own RUSTFLAGS — CachyOS sets target-cpu — still apply.
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/build"
  # --frozen: build the exact versions in the committed Cargo.lock, and fail
  # rather than reach for the network. What the tests ran against is what ships.
  cargo build --frozen --release
}

check() {
  cd "vayou-slint-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # --release, matching build(): a debug run would recompile the whole tree to
  # test code that is not the code being packaged.
  cargo test --frozen --release
}

package() {
  cd "vayou-slint-$pkgver"

  install -Dm755 target/release/vayou "$pkgdir/usr/bin/vayou"
  install -Dm644 assets/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/vayou.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # The entry carries @BINDIR@ rather than a path, so the same file serves this
  # package, install-linux.sh and the Flatpak build — each fills in its own.
  sed 's|@BINDIR@|/usr/bin|' installer/vayou.desktop |
    install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/vayou.desktop"
}
